# =============================================================================
# Gibber self-hosted stack — copy to .env and EDIT ALL SECRETS before booting.
#   cp .env.example .env
#   docker compose --profile slidge up -d     (core + all slidge gateways)
# =============================================================================

# =============================================================================
# Domain / edge
# =============================================================================
# Public hostname the web app + XMPP websockets are served from. It must match
# the XMPP domain in gibber-backend/config/prosody.cfg.lua (VirtualHost and
# the slidge-user-components.conf component subdomains).
# For a fully local test without DNS, leave gibberapp.online and reach the app
# through the backend directly on http://localhost:8080 instead.
GIBBER_SITE=gibberapp.online
GIBBER_ADMIN_EMAIL=admin@gibberapp.online

# =============================================================================
# Backend core
# =============================================================================
GIBBER_JWT_SECRET=change-me-in-production-use-a-strong-random-string
GIBBER_ADMIN_KEY=change-me-in-production
GIBBER_REGISTRATION_MODE=xmpp
GIBBER_PUSH_SECRET=change-me-in-production
# Optional integrations
GIBBER_GIPHY_API_KEY=

# =============================================================================
# Media cluster
# =============================================================================
GIBBER_JANUS_API_KEY=change-me-in-production
GIBBER_TURN_USER=gibber
GIBBER_TURN_PASS=change-me-in-production

# =============================================================================
# Slidge gateway component secrets
# Prosody and the matching gateway container MUST use the same value.
# =============================================================================
SLIDIRC_SECRET=change-me-irc-secret
SLIDGRAM_SECRET=change-me-telegram-secret
SLIDCORD_SECRET=change-me-discord-secret
MATRIDGE_SECRET=change-me-matrix-secret
SLIDGEWHATSAPP_SECRET=change-me-whatsapp-secret
# Global fallback used by the monolith deployment
GIBBER_SLIDGE_SECRET=change-me-in-production

# Open registration on the gateways (true = users can register their protocol
# accounts from the Gibber client directly). Keep false for private servers.

# Which gateways the BACKEND reports to clients (/gateways). Flip these to
# match the --profile you actually start: irc / telegram / discord / matrix /
# slidge. The landing-page join flow only needs SLIDIRC_ENABLED=true.
SLIDIRC_ENABLED=true
SLIDGRAM_ENABLED=false
SLIDCORD_ENABLED=false
MATRIDGE_ENABLED=false
SLIDGEWHATSAPP_ENABLED=false

# =============================================================================
# Per-protocol gateway credentials
# =============================================================================

# ---------------------------- IRC (slidirc) ----------------------------------
# The IRC network this gateway bridges. The landing page's trending rooms
# resolve to rooms on this network via the /gateways endpoint.
IRC_SERVER_HOSTNAME=irc.libera.chat
IRC_SERVER_PORT=6697

# ---------------------------- Telegram (slidgram) ----------------------------
# From https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# ---------------------------- Discord (slidcord) -----------------------------
# Create an application bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# ---------------------------- Matrix (matridge) ------------------------------
MATRIX_HOMESERVER=https://matrix.org

# ---------------------------- WhatsApp (slidge-whatsapp) ---------------------
WA_PHONE_NUMBER=

# =============================================================================
# Payments (optional)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=

# =============================================================================
# Cloudflare / Namecheap DNS-01 for Let's Encrypt + S2S federation (optional)
# =============================================================================
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_GLOBAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
NAMECHEAP_USERNAME=
NAMECHEAP_API_KEY=