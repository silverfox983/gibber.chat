# Biboumi configuration for the IRC gateway component.
# Rendered at container start by the `biboumi-config` init service, which
# replaces the __PLACEHOLDER__ values from the compose environment.
#
# NOTE on biboumi semantics: `hostname` is BOTH the component JID biboumi
# registers as AND the XMPP server it connects to. When the component JID is
# not resolvable inside the docker network, point the connection at the server
# container with `xmpp_server_ip`.
#
# In biboumi, `fixed_irc_server` is NOT a boolean: its value is the hostname
# of the single IRC network this gateway serves. Rooms are then joined as
# #channel@<hostname> (no %server suffix) - the JID format the Gibber client
# builds when joining a trending room from the landing page.

hostname=irc.gibberapp.online
port=5347
password=__SLIDIRC_SECRET__
xmpp_server_ip=__XMPP_SERVER_IP__

fixed_irc_server=__IRC_SERVER_HOSTNAME__

db_name=/var/lib/biboumi/biboumi.sqlite
log_level=0
realname_element=username
persistent_muc_list=false
require_whitelisted_ports=false
