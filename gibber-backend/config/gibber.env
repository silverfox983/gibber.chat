# Gibber Environment Configuration
# This file is baked into the Docker image and serves as a fallback
# when environment variables are not set or overridden by Railway.
# Railway dashboard variables take precedence over docker-compose values,
# but this file takes precedence over Railway dashboard variables.

GIBBER_REGISTRATION_MODE=xmpp
GIBBER_USE_DOCKER=1
GIBBER_JWT_SECRET=change-me-in-production-use-a-strong-random-string
GIBBER_PROSODY_URL=http://prosody:5280
GIBBER_ENABLE_SASL2=1
GIBBER_PUSH_SECRET=gibber-push-trigger-secret-change-in-production
