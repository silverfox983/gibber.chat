general: {
    server_name = "gibberapp.online"
    log_to_stdout = true
    log_level = 5
    daemon = false
    interface = "0.0.0.0"
    api_secret = "janus-api-key-change-in-production"
    token_auth = true
    token_auth_secret = "gibber-janus-token-secret"
    admin_port = 7088
    admin_secret = "janus-admin-secret-change-in-production"
}

media: {
    rtp_port_range = "10000-10020"
    ice_udp_port_range = "10000-10020"
    ice_tcp = false
}

nat: {
    stun_server = "stun.l.google.com"
    stun_port = 19302
}
