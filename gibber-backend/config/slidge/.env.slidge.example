# Slidge Gateway Environment Configuration
# Copy this file to .env.slidge and fill in your values
#
# SECURITY: Change all *_SECRET values before deploying!

# =======================
# XMPP Server Connection
# =======================
XMPP_SERVER=prosody
XMPP_PORT=5270

# =======================
# Telegram Gateway (Slidgram)
# =======================
SLIDGRAM_JID=telegram.gibberapp.online
SLIDGRAM_SECRET=CHANGE_ME_TELEGRAM_SECRET_123
SLIDGRAM_OPEN=false

# Get from https://my.telegram.org
TG_API_ID=12345
TG_API_HASH=your_telegram_api_hash_here

# =======================
# Discord Gateway (Slidcord)
# =======================
SLIDCORD_JID=discord.gibberapp.online
SLIDCORD_SECRET=CHANGE_ME_DISCORD_SECRET_456
SLIDCORD_OPEN=false

# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# =======================
# IRC Gateway
# =======================
SLIDIRC_JID=irc.gibberapp.online
SLIDIRC_SECRET=CHANGE_ME_IRC_SECRET_789
SLIDIRC_OPEN=false

# =======================
# Matrix Gateway (Matridge)
# =======================
MATRIDGE_JID=matrix.gibberapp.online
MATRIDGE_SECRET=CHANGE_ME_MATRIX_SECRET_abc
MATRIDGE_OPEN=false

# Matrix homeserver to bridge to (default: matrix.org)
MATRIX_HOMESERVER=https://matrix.org

# =======================
# Optional: WhatsApp Gateway
# =======================
# SLIDGEWHATSAPP_JID=whatsapp.gibberapp.online
# SLIDGEWHATSAPP_SECRET=CHANGE_ME_WHATSAPP_SECRET_def
# SLIDGEWHATSAPPER_OPEN=false
