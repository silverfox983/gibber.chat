# Railway Environment Variables for Gibber
# Copy these into the Railway Variables dashboard (or import as .env) for the monolith service.
# All secrets MUST be changed before production use.

# =============================================================================
# Core App
# =============================================================================
GIBBER_JWT_SECRET=change-me-in-production-use-a-strong-random-string
GIBBER_ADMIN_KEY=gibber-admin-key-change-in-production
GIBBER_REGISTRATION_MODE=xmpp
GIBBER_ENABLE_SASL2=1
GIBBER_USE_DOCKER=1
GIBBER_PROSODY_URL=http://localhost:5280
GIBBER_WEB_DIR=/app/web

# Optional: Giphy integration for GIF search
GIBBER_GIPHY_API_KEY=

# =============================================================================
# Payments (optional)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=

# =============================================================================
# Cloudflare DNS-01 for Let's Encrypt / S2S federation (set one provider)
# =============================================================================
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_GLOBAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
NAMECHEAP_USERNAME=
NAMECHEAP_API_KEY=

# =============================================================================
# Slidge / Transport Gateways
# Enable a gateway by setting GIBBER_<NAME>_ENABLED=true and providing the
# protocol-specific credentials below. The component secret is used for the
# XMPP external-component connection to Prosody.
# =============================================================================

# Global fallback for all gateway component secrets
GIBBER_SLIDGE_SECRET=change-me-in-production

# ----------------------------
# Telegram (Slidgram)
# ----------------------------
GIBBER_SLIDGRAM_ENABLED=true
GIBBER_SLIDGRAM_SECRET=change-me-telegram-secret
TG_API_ID=12345
TG_API_HASH=your_telegram_api_hash

# ----------------------------
# Discord (Slidcord)
# ----------------------------
GIBBER_SLIDCORD_ENABLED=true
GIBBER_SLIDCORD_SECRET=change-me-discord-secret
DISCORD_BOT_TOKEN=your_discord_bot_token

# ----------------------------
# IRC (SlidIRC)
# ----------------------------
GIBBER_SLIDIRC_ENABLED=true
GIBBER_SLIDIRC_SECRET=change-me-irc-secret
IRC_SERVER_HOSTNAME=irc.libera.chat
IRC_SERVER_PORT=6697

# ----------------------------
# Matrix (Matridge)
# ----------------------------
GIBBER_MATRIDGE_ENABLED=true
GIBBER_MATRIDGE_SECRET=change-me-matrix-secret
MATRIX_HOMESERVER=https://matrix.org

# ----------------------------
# WhatsApp (SlidgeWhatsApp)
# ----------------------------
GIBBER_SLIDGEWHATSAPPER_ENABLED=true
GIBBER_SLIDGEWHATSAPPER_SECRET=change-me-whatsapp-secret
WA_PHONE_NUMBER=+1234567890
